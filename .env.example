# ---------- Microsoft Entra ID (Azure AD) ----------
# ลงทะเบียนแอปที่ Entra admin center > App registrations
# Redirect URI (SPA): http://localhost:5173  และโดเมนจริงตอน deploy
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---------- Data source ----------
# mock = เก็บข้อมูลในเครื่อง (localStorage) | api = เรียก REST API (เช่น Azure App Service / Functions)
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=https://fleetgo-api.azurewebsites.net/api

# ---------- แอป Android (Capacitor Auto-Update Web Shell) ----------
# ลิงก์เว็บ HTTPS ที่ deploy แล้ว — แอปจะโหลดหน้าเว็บจากลิงก์นี้ และใช้กับปุ่ม "ลองใหม่อีกครั้ง" ในหน้า Fallback
VITE_WEB_URL=
